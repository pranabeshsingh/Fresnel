# ==============================================================================
# Fresnel 5G Suite - Environment Template
# ==============================================================================

# Server Security & Auth
PORT=8000
AUTH_TOKEN=change_this_to_a_secure_random_token_8892
DASHBOARD_PASSWORD=change_this_admin_password

# Database Mode (SQLite vs Oracle Autonomous DB)
DB_PATH=/app/data/telemetry.db
STATIC_DIR=/app/static

# Optional: Oracle Cloud Autonomous Database Configuration
# ORACLE_DB_USER=admin
# ORACLE_DB_PASS=YourOraclePassword123
# ORACLE_DB_DSN=yourdbname_low
# ORACLE_WALLET_DIR=/app/wallet
# ORACLE_WALLET_PASS=YourWalletPassword123

# Optional: Telegram Notifications Bot
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# TELEGRAM_CHAT_ID=123456789
